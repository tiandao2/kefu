NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://kf.example.com
# Optional additional exact origins, separated by commas (no trailing slash).
ALLOWED_ORIGINS=
SITE_NAME=在线客服
BOT_TOKEN=replace-me
TG_CHAT_ID=-1000000000000
STAFF_IDS=123456789,987654321
WEBHOOK_SECRET=generate-a-random-secret
DATA_DIR=/var/lib/kf-chat
# Primary: IP.cn. Secondary: https://ipwho.is with lang=zh-CN; no token needed.
GEO_ENABLED=1
# Rolling 24-hour attachment allowances; bytes, not MB.
UPLOAD_VISITOR_DAILY_BYTES=1048576000
UPLOAD_IP_DAILY_BYTES=2097152000
UPLOAD_VISITOR_DAILY_FILES=200
UPLOAD_IP_DAILY_FILES=1000
# Admission thresholds for files plus outstanding write reservations.
UPLOAD_TOTAL_BYTES=21474836480
UPLOAD_MIN_FREE_BYTES=2147483648
UPLOAD_CONCURRENT=4
UPLOAD_CONCURRENT_VISITOR=3
UPLOAD_CONCURRENT_IP=4
